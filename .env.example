# Shared application settings
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# LLM provider: openai | anthropic | google | openai-compatible | mock
LLM_PROVIDER=openai-compatible
LLM_PROVIDER_NAME=huggingface
LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.2
LLM_API_KEY=replace-me
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_SUPPORTS_STRUCTURED_OUTPUTS=true

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CONCURRENCY=3
AI_MAX_ANSWER_TOKENS=140
AI_MAX_VOTE_TOKENS=100

# Request tracking: disabled | memory | redis
REQUEST_TRACKING_MODE=memory
REQUEST_LIMIT=200
REDIS_URL=redis://localhost:6379
COUNTER_FAILURE_MODE=closed
ADMIN_KEY=replace-with-a-long-random-secret

# Per-IP HTTP protection
HTTP_RATE_LIMIT=60
HTTP_RATE_WINDOW_MS=60000

# Frontend-only variable (place in apps/web/.env when deploying separately)
VITE_API_URL=http://localhost:5000
