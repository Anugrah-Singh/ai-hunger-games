# Shared application settings
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
WEB_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# LLM provider: openai | anthropic | google | openai-compatible | mock
LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=replace-me

AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CONCURRENCY=3
AI_MAX_ANSWER_TOKENS=140
AI_MAX_VOTE_TOKENS=100

# Request tracking: disabled | memory
REQUEST_TRACKING_MODE=memory
REQUEST_LIMIT=200
ADMIN_KEY=replace-with-a-long-random-secret

# Per-IP HTTP protection
HTTP_RATE_LIMIT=60
HTTP_RATE_WINDOW_MS=60000

# Frontend-only variable (place in apps/web/.env when deploying separately)
# On Render: set as a Static Site environment variable (build-time, baked into bundle)
# Do NOT place in the API service — it has no effect there
VITE_API_URL=http://localhost:5000

# ── Render deployment notes ──────────────────────────────────────────────────
# All variables above apply to the API Web Service, EXCEPT VITE_API_URL.
# Do NOT set PORT on Render — Render injects it automatically.
# See render.yaml in the repo root for the full Blueprint configuration.
# After first deploy:
#   1. Set WEB_ORIGINS in API service to the static site URL
#   2. Set VITE_API_URL in static site to the API URL → triggers auto-redeploy

