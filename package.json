{
  "name": "ai-hunger-games",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @ai-hunger-games/contracts && npm run build --workspace @ai-hunger-games/api && npm run build --workspace @ai-hunger-games/web",
    "dev:api": "npm run dev --workspace @ai-hunger-games/api",
    "dev:web": "npm run dev --workspace @ai-hunger-games/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
